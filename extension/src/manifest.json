{
  "manifest_version": 3,
  "name": "Spikes402 Wallet",
  "version": "0.1.3",
  "description": "Non-custodial Lightning wallet for Spikes402 pages. Injects WebLN and keeps keys in this browser. No API key and no Spikes402 server: it talks to the Spark network, and to a Lightning address's server when you send to one.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Spikes402 Wallet",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "permissions": [
    "storage",
    "offscreen",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; frame-ancestors 'none'; connect-src 'self' https: wss://api.lightspark.com;"
  },
  "host_permissions": [
    "https://api.lightspark.com/*",
    "wss://api.lightspark.com/*",
    "https://0.spark.lightspark.com/*",
    "https://spark-operator.breez.technology/*",
    "https://2.spark.flashnet.xyz/*",
    "https://mempool.space/*",
    "https://regtest-mempool.us-west-2.sparkinfra.net/*"
  ]
}
